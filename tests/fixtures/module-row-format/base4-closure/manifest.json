    "total_seconds": 1200,
    "compiler_seconds": 600,
    "case_seconds": 60,
    "output_bytes": 8388608
  },
  "independence": "author.py is stdlib-only, imports no engine code and reuses no engine encoder; parents are pinned by sha256 below.",
  "runtime_tests": [
    {
      "selector": "storage::plan4_recovery_base::row::graph::tests::base4_closure_accepts_genesis_and_aging_start",
      "expected": "PASS",
      "reason": "genesis (0-owner XOI1) and AgingStart accepted with exact census; encode reproduces bytes; descriptor/active_descriptor accessors."
    },
    {
      "selector": "storage::plan4_recovery_base::row::graph::tests::base4_closure_live_actor_reaches_allocation_boundary",
      "expected": "PASS",
      "reason": "live literal closes queue/issuer(3 begins)/actors[1,2,0]/tables[1,3]/payloads(2)/INIT shape/ledger[1,1]/inventory(2 owners) and then fails closed with AllocationUnwired via decode and encode."
    },
    {
      "selector": "storage::plan4_recovery_base::row::graph::tests::base4_closure_entry_gates_profile_base_root_job",
      "expected": "PASS",
      "reason": "Profile 0/1/2/4/65535 envelopes rejected by row_profile; v1/v2 bootstrap profiles give Base(Unsupported); base 0/1/2/3/5/65535 Base(Unsupported); Root/Job 2/4 Retention(UnsupportedFormat); legacy base4 initial without XOI1 Corrupt."
    },
    {
      "selector": "storage::plan4_recovery_base::row::graph::tests::base4_closure_relation_variants",
      "expected": "PASS",
      "reason": "14 relation variants each pass decode_layout and are rejected by the closure with the listed error."
    },
    {
      "selector": "storage::plan4_recovery_base::row::graph::source::tests::base4_closure_source_bound_covers_measured_frames",
      "expected": "PASS",
      "reason": "Production source_census phases cover per-frame size_of inventories of every closure chain; prints ROW_BASE_SOURCE with Catalog base3 source_census/layout_source_bytes."
    }
  ],
