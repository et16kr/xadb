  "invariants": [
    {
      "id": "UR-01",
      "rule": "Undo redo may remain; rollback must not require reclaimed original log ranges."
    },
    {
      "id": "UR-02",
      "rule": "Undo chain, transaction state and allocation/data recovery closure must be durable before releasing undo log dependency."
    },
    {
      "id": "UR-03",
      "rule": "Capture read/sent position is not a durable restart position; open transaction and decoder state must survive original log reclamation."
    },
    {
      "id": "UR-04",
      "rule": "Persist payload and checkpoint selection before advancing retention ownership; retained fallback must be complete."
    },
    {
      "id": "UR-05",
      "rule": "Local redo, transaction undo, capture restart, backup/archive/standby are independent retention owners."
    },
    {
      "id": "UR-06",
      "rule": "Commit, abort and partial rollback semantics survive capture restart and target retry."
    },
    {
      "id": "UR-07",
      "rule": "No implicit loss on budget exhaustion; backpressure, explicit rejection or declared reseed transition."
    },
    {
      "id": "UR-08",
      "rule": "Current private/COW baseline and development order are preserved; undo-store engine requires a storage ADR."
    }
  ],
