        "fs/jbd2/journal.c:787 starts required commit and calls jbd2_log_wait_commit",
        "fs/jbd2/journal.c:652 waits for j_commit_sequence on j_wait_done_commit",
        "fs/jbd2/commit.c:1141 commit completion wakes that wait queue"
