      "version": "1.0.0",
      "binary_sha256": "RESOLVE_RELEASE_ARTIFACT_BEFORE_RUN"
    },
    "newer": {
      "version": "1.1.0",
      "binary_sha256": "RESOLVE_RELEASE_ARTIFACT_BEFORE_RUN"
    }
  },
  "fixture": {
    "private_data_directory": true,
    "exclusive_process_ownership": true,
    "logical_operations": "supported by both versions, with identical specified meaning",
    "illustrative_source_format": "FORMAT_1",
    "illustrative_target_format": "FORMAT_2",
    "conversion_required": true,
    "background_checkpoints": "controlled by runner so committed WAL remains above checkpoint at each specified crash"
  },
  "steps": [
    {
      "id": "old-create",
      "version": "older",
      "operation": "create_database_and_commit",
      "rows": [
        [
          "a",
          101
        ]
      ],
      "expect_reply": "COMMITTED"
    },
    {
      "id": "old-checkpoint",
      "version": "older",
      "operation": "checkpoint_and_confirm_durable_boundary"
    },
    {
      "id": "old-write",
      "version": "older",
      "operation": "commit",
      "rows": [
        [
          "b",
          202
        ]
      ],
      "expect_reply": "COMMITTED"
    },
    {
      "id": "old-crash",
      "version": "older",
