        [
          "a",
          101
        ],
        [
          "b",
          202
        ]
      ],
      "assert_integrity": true,
      "assert_single_complete_generation": true
    },
    {
      "id": "new-write",
      "version": "newer",
      "operation": "commit",
      "rows": [
        [
          "c",
          303
        ]
      ],
      "expect_reply": "COMMITTED"
    },
    {
      "id": "new-crash",
      "version": "newer",
      "operation": "kill_owned_server_before_next_checkpoint",
      "after": "new-write.reply_observed",
      "assert_process_exited": true
    },
    {
      "id": "new-reopen",
      "version": "newer",
      "operation": "recover_converted_database",
      "expect_rows": [
        [
          "a",
          101
        ],
        [
          "b",
          202
        ],
        [
          "c",
          303
        ]
      ],
      "assert_integrity": true
    }
  ],
