+#[test]
+fn r2_probe_forward() {
+    let value = value();
+    let (world, plan) = written(&value);
+    let front = page_ref(17, 2);
+    let head = OverflowHead::new(front, value.len(), plan.digest).unwrap();
+    let row_after = row_cell(&world, &head_record(&world, head));
+    let (allocator, chain) = chain_pages(&world);
+    let refs: Vec<&Page> = chain.iter().map(|page| &**page).collect();
+    let mut cycle = Box::new(*refs[1]);
+    let start = usize::from(u16::from_le_bytes([cycle[128], cycle[129]]));
+    front.encode(&mut cycle[start + 48..start + 72]).unwrap();
+    let digest = content_digest(&cycle[..DIGEST_OFFSET]);
+    cycle[DIGEST_OFFSET..].copy_from_slice(&digest);
+    // Chunk 2's own image re-homed at page 17: a distinct image whose cell
+    // index (2) is the expected one, so only the visited set sees the repeat.
+    let mut rehomed = Box::new(*refs[2]);
+    assert_eq!(u64_at(&rehomed[..], 32), 15);
+    rehomed[32..40].copy_from_slice(&17u64.to_le_bytes());
+    let digest = content_digest(&rehomed[..DIGEST_OFFSET]);
+    rehomed[DIGEST_OFFSET..].copy_from_slice(&digest);
+    let leased = restamped(refs[1], job(&world).lease_lsn());
+    let leased1 = restamped(refs[1], job(&world).lease_lsn() + 1);
+    let later = restamped(refs[1], world.lsn + 1);
+    let at_prev = restamped(refs[1], world.lsn);
+    let cases: Vec<(&str, Vec<&Page>)> = vec![
+        ("control", vec![refs[0], refs[1], refs[2]]),
+        ("dup same image (r2 test)", vec![refs[0], &*cycle, refs[0]]),
+        ("dup distinct image", vec![refs[0], &*cycle, &*rehomed]),
+        ("lsn = lease", vec![refs[0], &*leased, refs[2]]),
+        ("lsn = lease+1", vec![refs[0], &*leased1, refs[2]]),
+        ("lsn = prev+1", vec![refs[0], &*later, refs[2]]),
+        ("lsn = prev", vec![refs[0], &*at_prev, refs[2]]),
+    ];
+    for (label, pages) in cases {
+        let images = ChainImages {
+            allocator: &allocator,
+            pages: &pages,
+        };
+        let change = Change::ForwardOverflow {
+            ordinal: ORDINAL,
+            statement: boundary(4, None),
+            chain: &images,
+        };
+        let result = a_group(&world.inputs(change, row_pages()), Some(&row_after)).map(|f| f.len());
+        println!("R2PROBE\tforward {label}\t{result:?}");
+    }
+    println!("R2PROBE\tforward lease={} prev={}", job(&world).lease_lsn(), world.lsn);
+}
