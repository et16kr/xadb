+// ---- D2 r2 probes (scratch only) ----
+fn r2_touched(after: &[[u8; PAGE_BYTES]; 5], frame: &[u8]) -> bool {
+    !after.iter().flatten().all(|b| *b == 0xa5) || !frame.iter().all(|b| *b == 0xa5)
+}
