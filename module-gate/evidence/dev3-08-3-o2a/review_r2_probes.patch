+#[test]
+fn r2_probe_front() {
+    let value = value();
+    let mut world = h_506();
+    let reserved = reserve(&mut world, &value);
+    let before = world.clone();
+    chunk(&mut world, &reserved, &value, 15);
+    let stale = Box::new(before.allocator.unwrap());
+    let mk = |e: AllocationEntry| {
+        let mut entries = entries(&world);
+        entries[15] = e;
+        allocator_page(&entries, 5)
+    };
+    let foreign = mk(AllocationEntry::Allocated {
+        generation: generation(2),
+        object: ObjectId::new(7).unwrap(),
+        object_generation: generation(1),
+        kind: PageKind::Overflow,
+    });
+    let kind = mk(AllocationEntry::Allocated {
+        generation: generation(2),
+        object: table().object,
+        object_generation: table().generation,
+        kind: PageKind::RowLeaf,
+    });
+    let incarnation = mk(AllocationEntry::Allocated {
+        generation: generation(3),
+        object: table().object,
+        object_generation: table().generation,
+        kind: PageKind::Overflow,
+    });
+    let objgen = mk(AllocationEntry::Allocated {
+        generation: generation(2),
+        object: table().object,
+        object_generation: generation(2),
+        kind: PageKind::Overflow,
+    });
+    let current = Box::new(world.allocator.unwrap());
+    for (label, allocator) in [
+        ("current (control)", &current),
+        ("front Free", &stale),
+        ("front of another object", &foreign),
+        ("front of another kind", &kind),
+        ("front another incarnation", &incarnation),
+        ("front another object generation", &objgen),
+    ] {
+        let plan = ChunkPlan {
+            ordinal: ORDINAL,
+            allocator,
+            digest: reserved.digest,
+            payload: window(&value, 1),
+        };
+        let inputs = world.inputs(Change::ChunkWrite(&plan), chunk_pages());
+        let mut after = loans(0xa5);
+        let mut frame = vec![0xa5; FRAME_BYTES];
+        let result = produce(&inputs, &mut after, &mut frame).map(|o| o.frame_bytes);
+        println!(
+            "R2PROBE\tfront {label}\t{result:?}\ttouched={}",
+            r2_touched(&after, &frame)
+        );
+    }
+}
