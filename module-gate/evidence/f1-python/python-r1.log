ds\n        if: env.XADB_ADOPTED == \'true\' && env.XADB_RUST == \'true\'\n        run: |\n          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL\n          df -h /\n      - name: Install the pinned toolchain\n        if: env.XADB_ADOPTED == \'true\' && env.XADB_TOOLCHAIN == \'true\'\n        run: |\n          toolchain=$(sed -n \'s/^channel = "\\([^"]*\\)"/\\1/p\' rust-toolchain.toml)\n          test -n "$toolchain"\n          rustup toolchain install "$toolchain" --profile minimal\n      - name: Build and run the planned selection\n        if: env.XADB_ADOPTED == \'true\'\n        env:\n          BASE_SHA: ${{ github.event.pull_request.base.sha }}\n          HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n        run: >-\n          python3 -B "$RUNNER_TEMP/gate/module_gate_build.py" --repo .\n          --base "$BASE_SHA" --head "$HEAD_SHA" --policy "$XADB_POLICY"\n          --workflow .github/workflows/module-build.yml --out "$RUNNER_TEMP/receipt"\n      - name: Keep the receipt and logs\n        if: always() && env.XADB_ADOPTED == \'true\'\n        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2\n        with:\n          name: module-build-receipt\n          path: ${{ runner.temp }}/receipt\n          if-no-files-found: error\n          retention-days: 30\n'

